API_MASTER_KEY=
ENGINE_TYPE=baileys
OPENWA_MEM_LIMIT=2g
OPENWA_DOMAIN=wa.example.com
CSP_UPGRADE_INSECURE_REQUESTS=true

# Supabase project > Settings > Database > Connection string (use the
# pooled "Transaction" URI, port 6543, for a long-running server).
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres

# Supabase Storage S3-compatible endpoint (Settings > Storage > S3 Connection).
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=openwa-media
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
